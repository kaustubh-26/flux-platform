PORT=4001
NODE_ENV=development

LOG_LEVEL=info

CLIENT_ORIGIN=http://localhost:3000

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

COOKIE_NAME=flux_auth_token
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

CLIENT_SUCCESS_REDIRECT=http://localhost:3000/auth/success
CLIENT_FAILURE_REDIRECT=http://localhost:3000/auth/failure

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/flux_auth?retryWrites=true&w=majority
MONGODB_DB_NAME=flux_auth

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4001/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4001/auth/github/callback
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "pluginVersion": "10.2.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "$datasource"
          },
          "editorMode": "code",
          "expr": "{service=~\"$service\"} |= \"$search\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "📋 Live Log Stream (All Services)",
      "type": "logs"
    }
